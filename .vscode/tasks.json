{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Train demo baseline",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "run.py",
        "--mode",
        "baseline"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONDONTWRITEBYTECODE": "1"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Reproduce full pilot",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "run.py",
        "--mode",
        "full"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONDONTWRITEBYTECODE": "1"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Verify reference results",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "verify_results.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONDONTWRITEBYTECODE": "1"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Start local demo",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "demo.py",
        "--web"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONDONTWRITEBYTECODE": "1"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Run checks",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONDONTWRITEBYTECODE": "1"
        }
      },
      "problemMatcher": []
    }
  ]
}
